# Configuración de PRODUCCIÓN. En el servidor: copia este archivo a /srv/yikonpo/app/.env,
# rellénalo y protégelo:  chmod 600 .env    (el .env NUNCA se sube a git)
# Al arrancar, la plataforma comprueba que no falte nada importante (app/produccion.py).

FLASK_APP=run.py
FLASK_CONFIG=prod

# Clave secreta NUEVA, solo para producción (no reutilices la de tu ordenador):
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Base de datos PostgreSQL (usuario y base de datos creados en el paso 3 de DESPLIEGUE.md)
DATABASE_URL=postgresql+psycopg://yikonpo:CONTRASEÑA_DE_LA_BASE_DE_DATOS@localhost:5432/yikonpo

# Archivos subidos (fotos, documentos, facturas, SDS): fuera del código, y en las copias de seguridad
UPLOAD_FOLDER=/srv/yikonpo/datos/fotos_pedidos
DOCUMENTOS_FOLDER=/srv/yikonpo/datos/documentos

# Hora de la última copia de seguridad (la escribe deploy/copia_seguridad.sh): Administración → Estado
# avisa si pasan más de 2 días sin copia
COPIA_SEGURIDAD_MARCA=/srv/yikonpo/ultima_copia.txt

# nginx está delante de la aplicación (1). No lo cambies salvo que cambie el montaje.
NUM_PROXIES=1

# Correo saliente (los datos te los da quien gestione el correo del dominio)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Yikon Genomics PO <avisos@yikonsupport.com>
# Si un cliente responde a un aviso, la respuesta llega aquí (un buzón que alguien lea). Vacío: al remitente.
MAIL_REPLY_TO=
# Quién recibe por email los errores de la plataforma (separados por comas)
ADMIN_EMAILS=

# Soporte ChromGo (tickets): en pausa. Para activarlo, pon 1 y reinicia (sudo systemctl restart yikonpo)
SOPORTE_CHROMGO=0
# Documentos internos: en pausa. Igual: 1 y reiniciar.
DOCUMENTOS_INTERNOS=0

# Cabecera de las proformas (líneas separadas por "|")
EMPRESA_NOMBRE=Yikon Genomics España
EMPRESA_DATOS=
