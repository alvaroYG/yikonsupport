# Copia este archivo a .env y rellénalo. El .env NUNCA se sube a git.
# Genera la clave con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
FLASK_APP=run.py
FLASK_CONFIG=dev
# Solo en desarrollo: recarga sola al cambiar plantillas o código Python.
# NUNCA en producción (activa el depurador, que permite ejecutar código).
FLASK_DEBUG=1
# Correo (opcional en desarrollo: sin esto, los emails se guardan en instance/correos/)
# MAIL_SERVER=smtp.office365.com
# MAIL_PORT=587
# MAIL_USERNAME=plataforma@yikon...
# MAIL_PASSWORD=
# MAIL_FROM=Yikon Genomics PO <plataforma@yikon...>
# ADMIN_EMAILS=tu.email@yikon...   (reciben los errores de producción)
# En producción se usa otro .env: ver deploy/env.produccion.ejemplo y DESPLIEGUE.md
# DATABASE_URL=postgresql+psycopg://usuario:contraseña@servidor:5432/plataforma

# Datos de la empresa en la cabecera de las proformas (líneas separadas por "|")
# EMPRESA_NOMBRE=Yikon Genomics España
# EMPRESA_DATOS=C/ Ejemplo 1, 08000 Barcelona|CIF B00000000|pedidos@ejemplo.com

# Soporte ChromGo (tickets): en pausa por defecto. Pon 1 para activarlo.
SOPORTE_CHROMGO=0

# Documentos internos: en pausa por defecto. Pon 1 para activarlos.
DOCUMENTOS_INTERNOS=0
