msgid "Mensajes"
msgstr "Messages"

#: app/avisos_cliente.py:29
msgid "Proforma lista, en preparación, cambios y aceptada."
msgstr "Proforma ready, being prepared, changes and accepted."

#: app/avisos_cliente.py:30
msgid "Pedido registrado, en preparación, recibido y cancelado."
msgstr "Order registered, being prepared, received and cancelled."

#: app/avisos_cliente.py:31
msgid "Enviado (con el seguimiento) y cambios en los datos de envío."
msgstr "Shipped (with tracking) and changes to the shipping details."

#: app/avisos_cliente.py:32
msgid ""
"Mensajes nuevos de Yikon (a un usuario, uno hasta que entra a leerlos; a "
"un email en copia, uno por mensaje)."
msgstr ""
"New messages from Yikon (to a user, one until they log in to read them; "
"to a copied email, one per message)."

#: app/avisos_internos.py:37
msgid "Un cliente pide una proforma"
msgstr "A client requests a proforma"

#: app/avisos_internos.py:37
msgid "Hasta ahora solo salía en la campana."
msgstr "Until now it only showed in the bell."

#: app/avisos_internos.py:40
msgid "Un cliente pide cambios a la proforma"
msgstr "A client requests changes to the proforma"

#: app/avisos_internos.py:40
msgid "Con lo que pide cambiar (también queda en el chat)."
msgstr "With what they want changed (also kept in the chat)."

#: app/avisos_internos.py:43
msgid "Un cliente modifica su pedido antes de aceptarlo"
msgstr "A client changes their order before accepting it"

#: app/avisos_internos.py:44
msgid ""
"Con lo que llevaba y lo que lleva ahora. Si ya tenía la proforma, se "
"retira sola: hay que hacer otra."
msgstr ""
"With what it had and what it has now. If it already had a proforma, it is"
" withdrawn automatically: a new one is needed."

#: app/avisos_internos.py:47
msgid "Un cliente cancela su pedido antes de aceptarlo"
msgstr "A client cancels their order before accepting it"

#: app/avisos_internos.py:47
msgid "Con el motivo, si lo da."
msgstr "With the reason, if given."

#: app/avisos_internos.py:50
msgid "Un cliente acepta la proforma"
msgstr "A client accepts the proforma"

#: app/avisos_internos.py:50
msgid "Para empezar a prepararlo."
msgstr "So it can be prepared."

#: app/avisos_internos.py:53
msgid "Pedido listo para validar las fotos"
msgstr "Order ready for photo validation"

#: app/avisos_internos.py:53
msgid "Almacén lo ha preparado y ha subido las fotos."
msgstr "Warehouse has prepared it and uploaded the photos."

#: app/avisos_internos.py:56
msgid "Pedido devuelto a preparación"
msgstr "Order sent back to preparation"

#: app/avisos_internos.py:56
msgid "Soporte de cliente rechaza las fotos, con su comentario."
msgstr "Customer Support rejects the photos, with their comment."

#: app/avisos_internos.py:59
msgid "El cliente marca un pedido como recibido"
msgstr "The client marks an order as received"

#: app/avisos_internos.py:62
msgid "Mensaje nuevo de un cliente"
msgstr "New message from a client"

#: app/avisos_internos.py:63
msgid ""
"A admin, solo si el cliente no tiene Soporte de cliente asignado (o "
"ninguno lo recibe)."
msgstr ""
"To admin only if the client has no Customer Support assigned (or none of "
"them receives it)."

#: app/avisos_internos.py:66
msgid "Nota en el chat interno de un pedido"
msgstr "Note in an order's internal chat"

#: app/avisos_internos.py:69
msgid "Soporte de cliente comparte un mensaje del cliente"
msgstr "Client support shares a client message"

#: app/avisos_internos.py:70
msgid ""
"Desde la conversación general, que es privada entre el cliente y su "
"Soporte. Le llega solo al equipo con el que se comparte."
msgstr ""
"From the general conversation, which is private between the client and "
"their Support. Only the team it is shared with receives it."

#: app/avisos_internos.py:73
msgid "Un cliente avisa de un problema con un pedido"
msgstr "A client reports a problem with an order"

#: app/avisos_internos.py:74
msgid ""
"«Hay un problema con este pedido»: llegó dañado, falta algo, temperatura…"
" Se contesta en el chat del pedido."
msgstr ""
"“There is a problem with this order”: arrived damaged, something missing,"
" temperature… Reply in the order chat."

#: app/avisos_internos.py:77
msgid "Factura para revisar"
msgstr "Invoice to review"

#: app/avisos_internos.py:77
msgid "Se registra (o se corrige) una factura que pide revisión."
msgstr "An invoice that needs review is registered (or corrected)."

#: app/avisos_internos.py:80
msgid "Factura devuelta por Soporte de cliente"
msgstr "Invoice sent back by Customer Support"

#: app/avisos_internos.py:80
msgid "Con lo que hay que corregir."
msgstr "With what needs correcting."

#: app/avisos_internos.py:83
msgid "Alta de un cliente o de un usuario de un cliente"
msgstr "New client or new client user"

#: app/avisos_internos.py:84
msgid ""
"Los da de alta Soporte de cliente (los suyos); admin solo vigila: no "
"tiene que aprobar nada."
msgstr ""
"Created by Customer support (their own); admin only oversees: nothing to "
"approve."

#: app/avisos_internos.py:188
#, python-format
msgid "Cliente nuevo: %(cliente)s"
msgstr "New client: %(cliente)s"

#: app/avisos_internos.py:189
#, python-format
msgid "%(quien)s (%(rol)s) ha dado de alta el cliente %(cliente)s."
msgstr "%(quien)s (%(rol)s) has created the client %(cliente)s."

#: app/avisos_internos.py:197
#, python-format
msgid "Usuario nuevo en %(cliente)s: %(email)s"
msgstr "New user at %(cliente)s: %(email)s"

#: app/avisos_internos.py:198
#, python-format
msgid ""
"%(quien)s (%(rol)s) ha dado de alta a %(nombre)s (%(email)s) como usuario"
" de %(cliente)s."
msgstr ""
"%(quien)s (%(rol)s) has added %(nombre)s (%(email)s) as a user of "
"%(cliente)s."

#: app/avisos_internos.py:210
#, python-format
msgid "Proforma pedida: %(ref)s (%(cliente)s)"
msgstr "Proforma requested: %(ref)s (%(cliente)s)"

#: app/avisos_internos.py:211
#, python-format
msgid "%(quien)s (%(cliente)s) ha pedido una proforma: pedido %(ref)s."
msgstr "%(quien)s (%(cliente)s) has requested a proforma: order %(ref)s."

#: app/avisos_internos.py:213 app/templates/pedidos/detalle.html:32
#: app/templates/pedidos/preparar.html:53
#, python-format
msgid "Uso: %(uso)s"
msgstr "Use: %(uso)s"

#: app/avisos_internos.py:221
#, python-format
msgid "Cambios a la proforma %(numero)s (%(cliente)s)"
msgstr "Changes to proforma %(numero)s (%(cliente)s)"

#: app/avisos_internos.py:222
#, python-format
msgid ""
"%(quien)s (%(cliente)s) pide cambios a la proforma %(numero)s del pedido "
"%(ref)s."
msgstr ""
"%(quien)s (%(cliente)s) requests changes to proforma %(numero)s of order "
"%(ref)s."

#: app/avisos_internos.py:231
#, python-format
msgid "⚠ %(quien)s (%(cliente)s) ha modificado el pedido %(ref)s."
msgstr "⚠ %(quien)s (%(cliente)s) has changed order %(ref)s."

#: app/avisos_internos.py:234
#, python-format
msgid ""
"La proforma %(numero)s que tenía se ha retirado: hay que preparar y "
"enviar una nueva."
msgstr ""
"Proforma %(numero)s has been withdrawn: a new one must be prepared and "
"sent."

#: app/avisos_internos.py:237
msgid "Revisa el contenido antes de enviarle la proforma."
msgstr "Check the contents before sending the proforma."

#: app/avisos_internos.py:238
#, python-format
msgid "⚠ Pedido modificado por el cliente: %(ref)s (%(cliente)s)"
msgstr "⚠ Order changed by the client: %(ref)s (%(cliente)s)"

#: app/avisos_internos.py:240
