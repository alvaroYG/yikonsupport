#: app/pedidos/pendientes.py:65 app/templates/admin/_ajustes_nav.html:9
msgid "Proformas"
msgstr "Proformas"

#: app/avisos_cliente.py:24
msgid "Estado del pedido"
msgstr "Order status"

#: app/avisos_cliente.py:25
msgid "Envío y seguimiento"
msgstr "Shipping and tracking"

#: app/avisos_cliente.py:26 app/mensajes/routes.py:65 app/navegacion.py:59
#: app/pedidos/pendientes.py:65 app/templates/clientes/detalle.html:10
#: app/templates/layout.html:307 app/templates/layout.html:308
