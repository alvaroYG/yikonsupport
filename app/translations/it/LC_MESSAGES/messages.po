#: app/admin/ajustes_mas.py:59 app/avisos_cliente.py:23 app/main/inicio_yikon.py:54
#: app/pedidos/pendientes.py:60 app/pedidos/pendientes.py:65 app/templates/admin/_ajustes_nav.html:9
msgid "Proformas"
msgstr "Proforma"

#: app/avisos_cliente.py:24
msgid "Estado del pedido"
msgstr "Stato dell'ordine"

#: app/avisos_cliente.py:25
msgid "Envío y seguimiento"
msgstr "Spedizione e tracciamento"

#: app/avisos_cliente.py:26 app/mensajes/routes.py:65 app/navegacion.py:59 app/pedidos/pendientes.py:65
#: app/templates/clientes/detalle.html:10 app/templates/layout.html:307 app/templates/layout.html:308
#: app/templates/mensajes/_flotante_lista.html:3 app/templates/mensajes/lista.html:6
msgid "Mensajes"
msgstr "Messaggi"

#: app/avisos_cliente.py:29
msgid "Proforma lista, en preparación, cambios y aceptada."
msgstr "Proforma pronta, in preparazione, modifiche e accettata."

#: app/avisos_cliente.py:30
msgid "Pedido registrado, en preparación, recibido y cancelado."
msgstr "Ordine registrato, in preparazione, ricevuto e annullato."

#: app/avisos_cliente.py:31
msgid "Enviado (con el seguimiento) y cambios en los datos de envío."
msgstr "Spedito (con tracciamento) e modifiche ai dati di spedizione."

#: app/avisos_cliente.py:32
msgid ""
"Mensajes nuevos de Yikon (a un usuario, uno hasta que entra a leerlos; a un email en copia, uno "
"por mensaje)."
msgstr ""
"Nuovi messaggi da Yikon (a un utente, una notifica finché non accede per leggerli; a un indirizzo"
" email in copia, una per messaggio)."

#: app/avisos_internos.py:37
msgid "Un cliente pide una proforma"
msgstr "Un cliente richiede una proforma"

#: app/avisos_internos.py:37
msgid "Hasta ahora solo salía en la campana."
msgstr "Finora compariva solo nella campanella."

#: app/avisos_internos.py:40
msgid "Un cliente pide cambios a la proforma"
msgstr "Un cliente richiede modifiche alla proforma"

#: app/avisos_internos.py:40
msgid "Con lo que pide cambiar (también queda en el chat)."
msgstr "Con le modifiche richieste (restano anche nella chat)."

#: app/avisos_internos.py:43
msgid "Un cliente modifica su pedido antes de aceptarlo"
msgstr "Un cliente modifica il proprio ordine prima di accettarlo"

#: app/avisos_internos.py:44
msgid ""
"Con lo que llevaba y lo que lleva ahora. Si ya tenía la proforma, se retira sola: hay que hacer "
"otra."
msgstr ""
"Con il contenuto precedente e quello attuale. Se aveva già una proforma, viene ritirata "
"automaticamente: occorre prepararne un'altra."

#: app/avisos_internos.py:47
msgid "Un cliente cancela su pedido antes de aceptarlo"
msgstr "Un cliente annulla il proprio ordine prima di accettarlo"

#: app/avisos_internos.py:47
msgid "Con el motivo, si lo da."
msgstr "Con il motivo, se indicato."

#: app/avisos_internos.py:50
msgid "Un cliente acepta la proforma"
msgstr "Un cliente accetta la proforma"

#: app/avisos_internos.py:50
msgid "Para empezar a prepararlo."
msgstr "Per iniziare a prepararlo."

#: app/avisos_internos.py:53
msgid "Pedido listo para validar las fotos"
msgstr "Ordine pronto per la convalida delle foto"

#: app/avisos_internos.py:53
msgid "Almacén lo ha preparado y ha subido las fotos."
msgstr "Il Magazzino lo ha preparato e ha caricato le foto."

#: app/avisos_internos.py:56
msgid "Pedido devuelto a preparación"
msgstr "Ordine riportato in preparazione"

#: app/avisos_internos.py:56
msgid "Soporte de cliente rechaza las fotos, con su comentario."
msgstr "L'Assistenza clienti rifiuta le foto, con un commento."

#: app/avisos_internos.py:59
msgid "El cliente marca un pedido como recibido"
msgstr "Il cliente contrassegna un ordine come ricevuto"

#: app/avisos_internos.py:62
msgid "Mensaje nuevo de un cliente"
msgstr "Nuovo messaggio di un cliente"

#: app/avisos_internos.py:63
msgid "A admin, solo si el cliente no tiene Soporte de cliente asignado (o ninguno lo recibe)."
msgstr ""
"All'amministratore, solo se il cliente non ha un referente dell'Assistenza clienti assegnato (o "
"nessuno lo riceve)."

#: app/avisos_internos.py:66
msgid "Nota en el chat interno de un pedido"
msgstr "Nota nella chat interna di un ordine"

#: app/avisos_internos.py:69
msgid "Soporte de cliente comparte un mensaje del cliente"
msgstr "L'Assistenza clienti condivide un messaggio del cliente"

#: app/avisos_internos.py:70
msgid ""
"Desde la conversación general, que es privada entre el cliente y su Soporte. Le llega solo al "
"equipo con el que se comparte."
msgstr ""
"Dalla conversazione generale, privata tra il cliente e la sua Assistenza. Arriva solo al team con"
" cui viene condiviso."

#: app/avisos_internos.py:73
msgid "Un cliente avisa de un problema con un pedido"
msgstr "Un cliente segnala un problema con un ordine"

#: app/avisos_internos.py:74
msgid ""
"«Hay un problema con este pedido»: llegó dañado, falta algo, temperatura… Se contesta en el chat "
"del pedido."
msgstr ""
"«C'è un problema con questo ordine»: arrivato danneggiato, manca qualcosa, temperatura… Si "
"risponde nella chat dell'ordine."

#: app/avisos_internos.py:77
msgid "Factura para revisar"
msgstr "Fattura da verificare"

#: app/avisos_internos.py:77
msgid "Se registra (o se corrige) una factura que pide revisión."
msgstr "Viene registrata (o corretta) una fattura che richiede una verifica."

#: app/avisos_internos.py:80
msgid "Factura devuelta por Soporte de cliente"
msgstr "Fattura restituita dall'Assistenza clienti"

#: app/avisos_internos.py:80
msgid "Con lo que hay que corregir."
msgstr "Con le correzioni da apportare."

#: app/avisos_internos.py:83
msgid "Alta de un cliente o de un usuario de un cliente"
msgstr "Registrazione di un cliente o di un utente di un cliente"

#: app/avisos_internos.py:84
msgid "Los da de alta Soporte de cliente (los suyos); admin solo vigila: no tiene que aprobar nada."
msgstr ""
"Li registra l'Assistenza clienti (i propri); l'amministratore supervisiona soltanto: non deve "
"approvare nulla."

#: app/avisos_internos.py:188
#, python-format
msgid "Cliente nuevo: %(cliente)s"
msgstr "Nuovo cliente: %(cliente)s"

#: app/avisos_internos.py:189
#, python-format
msgid "%(quien)s (%(rol)s) ha dado de alta el cliente %(cliente)s."
msgstr "%(quien)s (%(rol)s) ha registrato il cliente %(cliente)s."

#: app/avisos_internos.py:197
#, python-format
msgid "Usuario nuevo en %(cliente)s: %(email)s"
msgstr "Nuovo utente di %(cliente)s: %(email)s"

#: app/avisos_internos.py:198
#, python-format
msgid "%(quien)s (%(rol)s) ha dado de alta a %(nombre)s (%(email)s) como usuario de %(cliente)s."
msgstr "%(quien)s (%(rol)s) ha registrato %(nombre)s (%(email)s) come utente di %(cliente)s."

#: app/avisos_internos.py:210
#, python-format
msgid "Proforma pedida: %(ref)s (%(cliente)s)"
msgstr "Proforma richiesta: %(ref)s (%(cliente)s)"

#: app/avisos_internos.py:211
#, python-format
msgid "%(quien)s (%(cliente)s) ha pedido una proforma: pedido %(ref)s."
msgstr "%(quien)s (%(cliente)s) ha richiesto una proforma: ordine %(ref)s."

#: app/avisos_internos.py:213 app/templates/pedidos/detalle.html:32
#: app/templates/pedidos/preparar.html:53
#, python-format
msgid "Uso: %(uso)s"
msgstr "Uso: %(uso)s"

#: app/avisos_internos.py:221
#, python-format
msgid "Cambios a la proforma %(numero)s (%(cliente)s)"
msgstr "Modifiche alla proforma %(numero)s (%(cliente)s)"

#: app/avisos_internos.py:222
