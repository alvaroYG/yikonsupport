msgid "En preparación"
msgstr "In preparazione"

#: app/ajustes.py:21 app/models.py:491
msgid "Pendiente de validación"
msgstr "In attesa di convalida"

#: app/ajustes.py:22
msgid "Listo para enviar, sin enviar"
msgstr "Pronto per la spedizione, da spedire"

#: app/ajustes.py:23
msgid "Proforma enviada, sin respuesta del cliente"
msgstr "Proforma inviata, in attesa di risposta del cliente"

#: app/ajustes.py:24
msgid "Enviado, sin confirmar la recepción"
msgstr "Spedito, ricezione da confermare"

#: app/apartados.py:46 app/buscador.py:53 app/clientes/exportar.py:77 app/navegacion.py:53
#: app/navegacion.py:54 app/pedidos/routes.py:163 app/pedidos/routes.py:211
#: app/templates/clientes/detalle.html:55 app/templates/clientes/detalle.html:66
#: app/templates/inventario/rastreo.html:47 app/templates/main/estadisticas.html:25
#: app/templates/main/estadisticas.html:107 app/templates/pedidos/lista.html:7
msgid "Pedidos"
msgstr "Ordini"

#: app/apartados.py:47
msgid ""
"Lista y ficha de los pedidos, proformas, documentos y el chat con el cliente (Almacén: desde que "
"el cliente acepta)."
msgstr ""
"Elenco e scheda degli ordini, proforma, documenti e chat con il cliente (Magazzino: "
"dall'accettazione del cliente)."

#: app/apartados.py:50
msgid "Preparar y fotos"
msgstr "Preparazione e foto"

#: app/apartados.py:50
msgid "Preparar los pedidos, hacer las fotos y enviarlos."
msgstr "Preparare gli ordini, scattare le foto e spedirli."

#: app/apartados.py:53 app/inventario/routes.py:82 app/navegacion.py:69
msgid "Inventario"
msgstr "Inventario"

#: app/apartados.py:53
msgid "Stock, entradas y salidas, reservas de lotes (Facturación: solo consulta)."
msgstr "Giacenze, entrate e uscite, prenotazioni dei lotti (Fatturazione: sola consultazione)."

#: app/apartados.py:56
msgid "Kits y productos"
msgstr "Kit e prodotti"

#: app/apartados.py:57
msgid "El catálogo. Al cliente: los productos activos con su ficha de seguridad, sin precios."
msgstr "Il catalogo. Per il cliente: i prodotti attivi con la relativa scheda di sicurezza, senza prezzi."

#: app/apartados.py:61
msgid "Lotes y trazabilidad"
msgstr "Lotti e tracciabilità"

#: app/apartados.py:62
msgid "La sección «Lotes» de cada pedido (qué lote sale y cuál salió) y «Rastrear lote»."
msgstr ""
"La sezione «Lotti» di ogni ordine (quale lotto viene spedito e quale è stato spedito) e «Traccia "
"lotto»."

#: app/apartados.py:66 app/buscador.py:109 app/clientes/routes.py:110 app/navegacion.py:75
#: app/templates/clientes/lista.html:5 app/templates/clientes/mapa.html:40
#: app/templates/mensajes/_flotante_lista.html:8
msgid "Clientes"
msgstr "Clienti"

#: app/apartados.py:67
msgid ""
"La ficha de cada cliente: datos, usuarios, facturación (Soporte de cliente: solo los suyos; los "
"da de alta él, con sus usuarios)."
msgstr ""
"La scheda di ogni cliente: dati, utenti, fatturazione (Assistenza clienti: solo i propri; li "
"registra insieme ai relativi utenti)."

#: app/apartados.py:73 app/buscador.py:191 app/clientes/exportar.py:70 app/facturas/routes.py:78
#: app/facturas/routes.py:96 app/navegacion.py:79 app/navegacion.py:80
#: app/templates/clientes/detalle.html:96 app/templates/facturas/lista.html:5
#: app/templates/pedidos/detalle.html:385 app/templates/pedidos/detalle.html:392
msgid "Facturas"
msgstr "Fatture"

#: app/apartados.py:74
msgid "Las facturas (al cliente, solo las suyas ya enviadas). Soporte de cliente, además, las revisa."
msgstr "Le fatture (per il cliente, solo le proprie già inviate). L'Assistenza clienti le verifica anche."

#: app/apartados.py:77
msgid "Sin él, Soporte de cliente no revisa facturas: las que lo pidan las revisará admin."
msgstr ""
"Senza questa opzione, l'Assistenza clienti non verifica le fatture: quelle che richiedono una "
"verifica saranno controllate dall'amministratore."

#: app/apartados.py:79 app/main/routes.py:175 app/navegacion.py:93
#: app/templates/main/estadisticas.html:13
msgid "Estadísticas"
msgstr "Statistiche"

#: app/apartados.py:79
msgid "Pedidos por mes, productos más pedidos y facturación por cliente."
msgstr "Ordini per mese, prodotti più ordinati e fatturato per cliente."

#: app/apartados.py:82 app/buscador.py:122 app/navegacion.py:83
msgid "Tickets ChromGo"
msgstr "Ticket ChromGo"

#: app/apartados.py:83
msgid "Soporte de ChromGo. Al cliente, solo a los usuarios con «Acceso a Soporte ChromGo» en su ficha."
msgstr ""
"Assistenza ChromGo. Per il cliente, solo agli utenti con «Accesso all'Assistenza ChromGo» nella "
"propria scheda."

#: app/apartados.py:86
msgid ""
"En pausa: actívalo cuando se empiece a usar. Los roles Soporte ChromGo y Cliente ChromGo solo se "
"ofrecen al crear usuarios si lo tienen activado."
msgstr ""
"In pausa: attivalo quando verrà utilizzato. I ruoli Assistenza ChromGo e Cliente ChromGo sono "
"disponibili alla creazione degli utenti solo se questa opzione è attiva."

#: app/apartados.py:89 app/buscador.py:204 app/documentos/routes.py:112 app/navegacion.py:87
#: app/templates/documentos/lista.html:11
msgid "Documentos internos"
msgstr "Documenti interni"

#: app/apartados.py:90
msgid ""
"Logos, plantillas y protocolos del equipo (no son los documentos de los pedidos). Subir y borrar:"
" solo admin."
msgstr ""
"Loghi, modelli e protocolli del team (non sono i documenti degli ordini). Caricamento ed "
"eliminazione: solo amministratore."

#: app/apartados.py:92
msgid "En pausa: actívalo cuando se empiece a usar."
msgstr "In pausa: attivalo quando verrà utilizzato."

#: app/apartados.py:94 app/navegacion.py:90
msgid "Administración"
msgstr "Amministrazione"

#: app/apartados.py:94
msgid "Usuarios, auditoría y estos ajustes."
msgstr "Utenti, registro attività e queste impostazioni."

#: app/apartados.py:97 app/pedidos/pendientes.py:128 app/templates/mensajes/lista.html:50
msgid "Conversación general"
msgstr "Conversazione generale"

#: app/apartados.py:98
msgid ""
"Ver y escribir en la conversación general de cada cliente (la que no va de un pedido). Sin ella, "
"Facturación y Almacén solo ven lo que les comparten, y Soporte de cliente la lee pero no escribe."
msgstr ""
"Visualizzare e scrivere nella conversazione generale di ogni cliente (non legata a un ordine). "
"Senza questa opzione, Fatturazione e Magazzino vedono solo i contenuti condivisi con loro e "
"l'Assistenza clienti può leggere ma non scrivere."

#: app/apartados.py:102 app/apartados.py:109
msgid "Quién habla con los clientes"
msgstr "Chi comunica con i clienti"

#: app/apartados.py:104
msgid "Mensajes en los pedidos"
msgstr "Messaggi negli ordini"

#: app/apartados.py:105
msgid ""
"Escribir al cliente en la conversación de cada pedido (Almacén: desde que el cliente acepta). Sin"
" ella, la lee pero no escribe; el chat interno del pedido no cambia."
msgstr ""
"Scrivere al cliente nella conversazione di ogni ordine (Magazzino: dall'accettazione del "
"cliente). Senza questa opzione, può leggere ma non scrivere; la chat interna dell'ordine rimane "
"invariata."

