#: app/templates/inventario/reservas.html:43
msgid ""
"El cliente ya aceptó la proforma con estas caducidades. Para soltar los lotes, cancela el pedido "
"o rehaz la proforma."
msgstr ""
"Il cliente ha già accettato la proforma con queste scadenze. Per liberare i lotti, annulla "
"l'ordine o rifai la proforma."

