#: app/__init__.py:332
msgid "No tienes permiso para ver esta página."
msgstr "Non hai il permesso di visualizzare questa pagina."

#: app/__init__.py:337
msgid "La página que buscas no existe."
msgstr "La pagina che cerchi non esiste."

#: app/__init__.py:351
msgid "Algo ha fallado. Inténtalo de nuevo."
msgstr "Si è verificato un errore. Riprova."

#: app/ajustes.py:17
msgid "Proforma solicitada, sin preparar"
msgstr "Proforma richiesta, da preparare"

#: app/ajustes.py:18
msgid "Cambios pedidos por el cliente, sin atender"
msgstr "Modifiche richieste dal cliente, da gestire"

#: app/ajustes.py:19
msgid "Aceptado, sin empezar"
msgstr "Accettato, da iniziare"

