msgstr "Hazırlanıyor"

#: app/ajustes.py:21 app/models.py:491
msgid "Pendiente de validación"
msgstr "Onay bekliyor"

#: app/ajustes.py:22
msgid "Listo para enviar, sin enviar"
msgstr "Gönderime hazır, gönderilmedi"

#: app/ajustes.py:23
msgid "Proforma enviada, sin respuesta del cliente"
msgstr "Proforma gönderildi, müşteri yanıtı bekleniyor"

#: app/ajustes.py:24
msgid "Enviado, sin confirmar la recepción"
msgstr "Gönderildi, teslim alındığı doğrulanmadı"

