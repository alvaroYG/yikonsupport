#: app/__init__.py:332
msgid "No tienes permiso para ver esta página."
msgstr "Bu sayfayı görüntüleme izniniz yok."

#: app/__init__.py:337
msgid "La página que buscas no existe."
msgstr "Aradığınız sayfa mevcut değil."

#: app/__init__.py:351
msgid "Algo ha fallado. Inténtalo de nuevo."
msgstr "Bir hata oluştu. Tekrar deneyin."

#: app/ajustes.py:17
msgid "Proforma solicitada, sin preparar"
msgstr "Proforma talep edildi, hazırlanmadı"

#: app/ajustes.py:18
msgid "Cambios pedidos por el cliente, sin atender"
msgstr "Müşterinin istediği değişiklikler bekliyor"

#: app/ajustes.py:19
msgid "Aceptado, sin empezar"
msgstr "Kabul edildi, başlanmadı"

