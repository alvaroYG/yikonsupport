#: app/archivos.py:38
#, python-format
msgid "«%(nombre)s»: tipo no admitido. Usa %(tipos)s."
msgstr "«%(nombre)s»: desteklenmeyen tür. Şunları kullanın: %(tipos)s."

#: app/archivos.py:42 app/pedidos/documentos.py:46 app/pedidos/fotos.py:52
